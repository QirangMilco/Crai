{
  "configDirName": ".crai-dev",
  "workspaceDataDirName": ".crai-dev",
  "server": {
    "defaultPort": 8080,
    "disableAuth": false
  },
  "debug": {
    "trace": false,
    "logLevel": "debug",
    "logDir": "logs",
    "maxFileSize": 10485760,
    "maxBackups": 3,
    "scopes": {
      "server": ["merge", "middleware", "title-gen"],
      "client": ["timeline", "merge", "middleware", "tools", "title-gen"]
    }
  }
}
