{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "examples/*/index.ts"
  ],
  "exclude": ["node_modules"]
}
